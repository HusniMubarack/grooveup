AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_TRUST_HOST=true

# Production (Vercel): hosted SQLite on Turso. Leave unset locally; the app then uses prisma/dev.db.
# TURSO_DATABASE_URL="libsql://your-db-your-org.turso.io"
# TURSO_AUTH_TOKEN=""

# Optional: Mux video hosting (teachers upload in the Studio; students stream with signed, expiring links).
# Without these, lessons use pasted MP4 links. See README → "Video hosting (Mux)".
# MUX_TOKEN_ID=""
# MUX_TOKEN_SECRET=""
# MUX_SIGNING_KEY=""        # signing key ID
# MUX_PRIVATE_KEY=""        # base64 private key shown once when the signing key is created
